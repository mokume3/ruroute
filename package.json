{
  "name": "ruroute",
  "type": "module",
  "version": "0.5.0",
  "description": "Type-safe route definitions and URL builder",
  "author": "mokume3 <mokume.dev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mokume3/ruroute#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokume3/ruroute.git"
  },
  "bugs": {
    "url": "https://github.com/mokume3/ruroute/issues"
  },
  "keywords": [
    "typescript",
    "url",
    "route",
    "builder",
    "routing",
    "type-safe"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./type": "./dist/type.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.ja.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "bench": "tsdown && vitest bench --run --reporter=verbose",
    "size": "tsdown && node scripts/size.ts",
    "check:treeshake": "tsdown && node scripts/check-treeshake.ts",
    "check:type-perf": "node scripts/check-type-perf.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset git-tag && git push --follow-tags",
    "prepublishOnly": "pnpm run build",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.6.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "routopia": "1.2.3",
    "tsdown": "^0.23.5",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
